{
  "name": "diy-projects",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "preinstall": "node -e \"if(!/^pnpm\\//.test(process.env.npm_config_user_agent||'')){console.error('Use pnpm (D-0019): pnpm install');process.exit(1)}\"",
    "prepare": "node -e \"const fs=require('fs');if(fs.existsSync('.git')){try{require('child_process').execSync('git config core.hooksPath .githooks',{stdio:'inherit'})}catch{console.warn('prepare: could not set core.hooksPath (D-0017)')}}\"",
    "tasks:index": "node scripts/tasks-index.mjs"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.46",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "exifr": "^7.1.3",
    "pocketbase": "^0.29.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@fontsource/poppins": "^5.3.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "workbox-window": "^7.4.1"
  },
  "packageManager": "pnpm@12.18.0"
}
