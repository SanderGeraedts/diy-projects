# Copy to <dataset>/.env on the NAS (next to serve.json). Never commit the real file (D-0010).

# One-time Tailscale auth key (admin console -> Settings -> Keys). Only needed for the first
# start; the login is kept in tailscale/. Remove this line once the machine is on the tailnet.
TS_AUTHKEY=tskey-auth-REPLACE-ME

# Only if the GHCR package ghcr.io/sandergeraedts/diy-projects-pocketbase stays private:
# a GitHub token with only read:packages, for Watchtower.
# REPO_USER=REPLACE-ME
# REPO_PASS=REPLACE-ME
